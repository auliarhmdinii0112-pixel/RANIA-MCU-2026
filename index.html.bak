<!doctype html>
<html lang="id">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>RANIA — MCU Control Tower 2026</title>
<script src="https://cdn.jsdelivr.net/npm/xlsx@0.18.5/dist/xlsx.full.min.js"></script>
<style>
:root{--green:#0b7a3b;--green2:#13a05a;--ink:#163126;--muted:#71817a;--bg:#f4f8f5;--card:#fff;--line:#dce8e0;--danger:#c83b3b;--amber:#c98500}
*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--ink);font:14px Inter,system-ui,-apple-system,Segoe UI,Roboto,Arial,sans-serif}
header{background:linear-gradient(120deg,#075a2d,#12a05a);color:#fff;padding:18px 24px;position:sticky;top:0;z-index:10;box-shadow:0 5px 18px #0b7a3b20}
.top{max-width:1500px;margin:auto;display:flex;align-items:center;gap:16px}.brand{display:flex;align-items:center;gap:12px}.logo{width:46px;height:46px;border-radius:14px;background:#fff;color:var(--green);display:grid;place-items:center;font-weight:900;font-size:19px;box-shadow:0 6px 16px #0002}.title h1{margin:0;font-size:21px}.title p{margin:2px 0 0;opacity:.85}.right{margin-left:auto;display:flex;gap:8px;align-items:center}
main{max-width:1500px;margin:22px auto;padding:0 18px}.toolbar,.panel,.kpi{background:var(--card);border:1px solid var(--line);border-radius:16px;box-shadow:0 5px 18px #16312608}.toolbar{padding:14px;display:flex;gap:10px;align-items:center;flex-wrap:wrap}.toolbar label{font-size:12px;color:var(--muted);font-weight:700}.toolbar input,.toolbar select,.toolbar button,.search input{height:40px;border:1px solid var(--line);border-radius:10px;background:#fff;padding:0 12px;color:var(--ink)}button{cursor:pointer;font-weight:750}.primary{background:var(--green);color:#fff;border-color:var(--green)!important}.ghost{background:#fff}.danger{color:var(--danger)}.sync{padding:8px 11px;border-radius:999px;background:#eaf7ef;color:var(--green);font-weight:800;font-size:12px}.sync.off{background:#fff3df;color:var(--amber)}
.kpis{display:grid;grid-template-columns:repeat(5,1fr);gap:12px;margin:14px 0}.kpi{padding:17px}.kpi .n{font-size:27px;font-weight:900}.kpi .l{color:var(--muted);font-size:12px;margin-top:3px}
.grid{display:grid;grid-template-columns:1.25fr .75fr;gap:14px}
.monitoring-grid{display:grid;grid-template-columns:1.15fr .85fr;gap:12px;margin:10px 0 14px}
.monitor-box{border:1px solid var(--line);border-radius:12px;background:#fbfefc;padding:12px}
.monitor-box h3{margin:0 0 10px;font-size:13px}
.monitor-table{width:100%;border-collapse:collapse;font-size:12px}
.monitor-table th,.monitor-table td{padding:7px 6px;border-bottom:1px solid var(--line);text-align:left}
.monitor-table th{color:var(--muted);font-weight:700}
.monitor-table td:not(:first-child),.monitor-table th:not(:first-child){text-align:right}
.monitor-mini-bar{height:7px;background:#e8f0eb;border-radius:99px;overflow:hidden;margin-top:4px}
.monitor-mini-bar i{display:block;height:100%;background:var(--green);border-radius:99px;transition:width .15s ease}
@media(max-width:850px){.monitoring-grid{grid-template-columns:1fr}}
.panel{padding:16px}.panel h2{font-size:15px;margin:0 0 12px}.search{display:flex;gap:8px;margin-bottom:10px}.search input{width:100%}
table{width:100%;border-collapse:collapse}th,td{padding:10px 8px;border-bottom:1px solid #edf2ee;text-align:left;font-size:12px}th{color:var(--muted);font-size:11px;text-transform:uppercase;letter-spacing:.04em}.status{padding:5px 8px;border-radius:999px;font-size:11px;font-weight:800;display:inline-block}.s0{background:#eef2f0;color:#61716a}.s1{background:#fff0d8;color:#9a6500}.s2{background:#e6f7ed;color:#08763a}.s3{background:#fde8e8;color:#ad2929}.actions{display:flex;gap:5px;flex-wrap:wrap}.actions button{height:30px;padding:0 8px;border-radius:8px;font-size:11px;border:1px solid var(--line);background:#fff}.actions .done{background:#e6f7ed;color:#08763a;border-color:#bfe6ce}
.history{display:grid;grid-template-columns:repeat(3,1fr);gap:8px}.day{border:1px solid var(--line);border-radius:12px;padding:11px;background:#fbfdfb;cursor:pointer}.day strong{display:block}.day span{font-size:11px;color:var(--muted)}
.bar{height:9px;background:#e8efeb;border-radius:99px;overflow:hidden;margin-top:7px}.bar i{display:block;height:100%;background:linear-gradient(90deg,var(--green),var(--green2))}
.empty{text-align:center;color:var(--muted);padding:35px 10px}.footer{text-align:center;color:#819089;font-size:11px;padding:20px}
.modal{position:fixed;inset:0;background:#06160d88;display:none;align-items:center;justify-content:center;z-index:30;padding:18px}.modal.show{display:flex}.modalbox{background:#fff;border-radius:18px;max-width:680px;width:100%;padding:20px;max-height:90vh;overflow:auto}.modalbox h3{margin-top:0}.code{background:#0f1914;color:#d7f4df;padding:12px;border-radius:10px;font:12px ui-monospace,monospace;white-space:pre-wrap}
@media(max-width:1000px){.kpis{grid-template-columns:repeat(2,1fr)}.grid{grid-template-columns:1fr}.history{grid-template-columns:repeat(2,1fr)}}@media(max-width:600px){.kpis{grid-template-columns:1fr 1fr}.history{grid-template-columns:1fr}.top{padding:0 4px}.right .label{display:none}th:nth-child(4),td:nth-child(4){display:none}}
</style>
</head>
<body>
<header><div class="top">
  <div class="brand"><div class="logo">RA</div><div class="title"><h1>RANIA</h1><p>Real-time Attendance & MCU Intelligence Analytics</p></div></div>
  <div class="right"><span id="sync" class="sync off">LOCAL / BELUM TERHUBUNG FIREBASE</span><button class="ghost" onclick="openSettings()">⚙ Firebase</button></div>
</div></header>

<main>
<div class="toolbar">
  <div><label>Tanggal MCU</label><br><input id="date" type="date"></div>
  <div><label>Mode Data</label><br><select id="viewMode"><option value="master">Semua Master</option><option value="date">MCU per Tanggal</option></select></div><div><label>AFD</label><br><select id="filterAfd"><option value="">Semua AFD</option></select></div><div><label>Status</label><br><select id="filterStatus"><option value="">Semua</option><option>BELUM HADIR</option><option>HADIR / PROSES</option><option>MCU SELESAI</option><option>TIDAK HADIR</option></select></div>
  <div style="flex:1"></div>
  <button class="primary" onclick="applyFilters()">🔎 Terapkan Filter</button><button onclick="resetAllFilters()">↺ Reset Filter</button><button onclick="document.getElementById('file').click()">📥 Import Master Excel</button>
  <input id="file" type="file" accept=".xlsx,.xls" hidden onchange="importExcel(event)">
  <button class="primary" onclick="exportHistory()">⬇ Export Excel</button>
  <button onclick="openSettings()">🔒 Master & Firebase</button>
</div>

<div class="panel" style="margin-top:14px;padding:10px 14px;font-size:12px;background:#f8fcf9">
  <b>Alur operator:</b> pilih <b>MCU per Tanggal</b> untuk kontrol harian, atau tetap di <b>Semua Master</b> untuk mencari peserta. Klik <b>Hadir → Selesai</b>. <b>Reset</b> mengembalikan ke BELUM HADIR dan menghapus timestamp transaksi.
</div>

<div class="kpis">
  <div class="kpi"><div class="n" id="kTotal">0</div><div class="l">Peserta master / terjadwal</div></div>
  <div class="kpi"><div class="n" id="kHad">0</div><div class="l">Hadir / proses</div></div>
  <div class="kpi"><div class="n" id="kDone">0</div><div class="l">MCU selesai</div></div>
  <div class="kpi"><div class="n" id="kAbsent">0</div><div class="l">Tidak hadir</div></div>
  <div class="kpi"><div class="n" id="kProgress">0%</div><div class="l">Progress selesai</div></div>
</div>

<div class="grid">
<section class="panel">
  <h2 id="operatorTitle">Operator MCU — <span id="dateLabel"></span></h2>
  <div id="attendanceSummary" style="display:flex;gap:8px;flex-wrap:wrap;margin:-3px 0 10px"></div>
  <div class="monitoring-grid">
    <div class="monitor-box">
      <h3>Monitoring Per AFD</h3>
      <div id="afdMonitoring"></div>
    </div>
    <div class="monitor-box">
      <h3>Monitoring Per Jam</h3>
      <div id="hourlyTop"></div>
    </div>
  </div>

  <div style="font-size:11px;color:var(--muted);margin-bottom:8px">Klik <b>Hadir</b>, <b>Selesai</b>, <b>Tidak Hadir</b>, atau <b>Reset</b>. Pada mode Semua Master, transaksi otomatis masuk ke tanggal jadwal masing-masing.</div><div class="search"><input id="search" placeholder="Cari NIK / nama / AFD / perusahaan..." oninput="renderTable()"><button onclick="resetSearch()">Reset</button></div>
  <div style="overflow:auto"><table><thead><tr><th>NIK</th><th>Nama</th><th>AFD</th><th>Paket</th><th>Status</th><th>Aksi</th></tr></thead><tbody id="rows"></tbody></table></div>
</section>
<section class="panel">
  <h2>Historical MCU per Tanggal</h2>
  <div id="history" class="history"></div>
</section>
</div>
<div class="footer">RANIA v1.9 • Master Persistent + Historical Attendance • Designed & Powered by Aulia</div>
</main>

<div id="modal" class="modal"><div class="modalbox">
  <h3>Master & Firebase</h3>
  <p><b>Mode saat ini:</b> Master dan transaksi disimpan di browser menggunakan IndexedDB. Ini aman terhadap refresh pada perangkat yang sama, tetapi <b>belum aman lintas perangkat</b>.</p>
  <p>Untuk penyimpanan cloud lintas HP/laptop, masukkan konfigurasi Firebase di bawah. Setelah terhubung, Firestore menjadi sumber data utama.</p>
  <textarea id="fbConfig" style="width:100%;min-height:180px;border:1px solid var(--line);border-radius:10px;padding:10px;font:12px monospace" placeholder='{"apiKey":"...","authDomain":"...","projectId":"...","storageBucket":"...","messagingSenderId":"...","appId":"..."}'></textarea>
  <div style="display:flex;gap:8px;margin-top:10px"><button class="primary" onclick="saveFirebase()">Simpan Konfigurasi</button><button onclick="document.getElementById('modal').classList.remove('show')">Tutup</button><button onclick="clearAllLocal()" class="danger">Hapus data lokal</button></div>
  <p style="font-size:11px;color:var(--muted)">Jangan masukkan service-account private key. Web Firebase config dapat digunakan di frontend; keamanan data harus ditegakkan dengan Firebase Authentication + Firestore Security Rules.</p>
</div></div>

<script type="module">
import { initializeApp } from "https://www.gstatic.com/firebasejs/11.10.0/firebase-app.js";
import { getFirestore, collection, doc, getDocs, setDoc, writeBatch, onSnapshot, query, where } from "https://www.gstatic.com/firebasejs/11.10.0/firebase-firestore.js";
import { getAuth, signInAnonymously } from "https://www.gstatic.com/firebasejs/11.10.0/firebase-auth.js";

const DB_NAME='RANIA_MCU_V1', DB_VER=1;
let master=[], attendance={}, fb=null, fs=null, auth=null, unsub=null;

const $=id=>document.getElementById(id);
const today=new Date().toISOString().slice(0,10);
$('date').value=today;

function openDB(){return new Promise((res,rej)=>{const r=indexedDB.open(DB_NAME,DB_VER);r.onupgradeneeded=()=>{const d=r.result;if(!d.objectStoreNames.contains('master'))d.createObjectStore('master',{keyPath:'nik'});if(!d.objectStoreNames.contains('attendance'))d.createObjectStore('attendance',{keyPath:'id'});};r.onsuccess=()=>res(r.result);r.onerror=()=>rej(r.error)})}
async function localLoad(){const d=await openDB();return new Promise((res,rej)=>{const tx=d.transaction(['master','attendance'],'readonly');const a=[];const b=[];tx.objectStore('master').openCursor().onsuccess=e=>{const c=e.target.result;if(c){a.push(c.value);c.continue()}};tx.objectStore('attendance').openCursor().onsuccess=e=>{const c=e.target.result;if(c){b.push(c.value);c.continue()}};tx.oncomplete=()=>{master=a;attendance=Object.fromEntries(b.map(x=>[x.id,x]));res()};tx.onerror=()=>rej(tx.error)})}
async function localPut(store,obj){const d=await openDB();return new Promise((res,rej)=>{const tx=d.transaction(store,'readwrite');tx.objectStore(store).put(obj);tx.oncomplete=res;tx.onerror=()=>rej(tx.error)})}
async function localClear(){const d=await openDB();return new Promise((res,rej)=>{const tx=d.transaction(['master','attendance'],'readwrite');tx.objectStore('master').clear();tx.objectStore('attendance').clear();tx.oncomplete=res;tx.onerror=()=>rej(tx.error)})}

window.openSettings=()=>{ $('modal').classList.add('show'); $('fbConfig').value=localStorage.getItem('RANIA_FIREBASE_CONFIG')||'' };
window.clearAllLocal=async()=>{if(confirm('Hapus MASTER dan HISTORY lokal dari perangkat ini?')){await localClear();master=[];attendance={};render();alert('Data lokal dihapus. Data Firestore tidak terhapus.')}};
window.saveFirebase=async()=>{try{const cfg=JSON.parse($('fbConfig').value);localStorage.setItem('RANIA_FIREBASE_CONFIG',JSON.stringify(cfg));await connectFirebase(cfg);$('modal').classList.remove('show')}catch(e){alert('Konfigurasi Firebase belum valid: '+e.message)}};

async function connectFirebase(cfg){
  fb=initializeApp(cfg,'rania-'+Date.now());fs=getFirestore(fb);auth=getAuth(fb);
  await signInAnonymously(auth);
  $('sync').textContent='● FIREBASE CONNECTED';$('sync').classList.remove('off');
  const ms=await getDocs(collection(fs,'employees')); master=ms.docs.map(d=>d.data());
  const as=await getDocs(collection(fs,'attendance')); attendance=Object.fromEntries(as.docs.map(d=>[d.id,d.data()]));
  render();
}
async function saveAttendance(row,status,dateOverride){
  const targetDate=dateOverride||$('date').value;
  const id=row.nik+'_'+targetDate;
  const old=attendance[id]||{id,nik:row.nik,scheduledDate:targetDate};
  const now=new Date().toISOString();
  let item={...old,status,updatedAt:now};
  if(status==='BELUM HADIR'){
    item={id,nik:row.nik,scheduledDate:targetDate,status:'BELUM HADIR',updatedAt:now};
  }else{
    if(status==='HADIR / PROSES' && !old.checkInAt)item.checkInAt=now;
    if(status==='MCU SELESAI'){
      if(!item.checkInAt)item.checkInAt=now;
      item.completedAt=now;
    }
    if(status==='TIDAK HADIR')item.absentAt=old.absentAt||now;
  }
  // Update in-memory state first so the dashboard reacts immediately.
  attendance[id]=item;
  renderFastDashboard();
  // Render the heavy participant table on the next paint, so KPI/AFD/jam can update first.
  requestAnimationFrame(()=>renderTable());

  // Persist without blocking the UI.
  Promise.resolve().then(()=>localPut('attendance',item))
    .then(()=>fs ? setDoc(doc(fs,'attendance',id),item,{merge:true}) : null)
    .catch(err=>{
      console.error('Gagal menyimpan transaksi MCU:',err);
      const sync=$('sync');
      if(sync){sync.textContent='● GAGAL SYNC';sync.classList.add('off');}
    });
}
window.setStatus=(nik,status,dateOverride)=>{const r=master.find(x=>x.nik===nik);if(r)saveAttendance(r,status,dateOverride||$('date').value)};
window.resetSearch=()=>{$('search').value='';if($('filterAfd'))$('filterAfd').value='';if($('filterStatus'))$('filterStatus').value='';render()};
function applyFilters(){ render(); }
window.applyFilters=applyFilters;
window.resetAllFilters=()=>{
  $('search').value='';
  $('filterAfd').value='';
  $('filterStatus').value='';
  $('viewMode').value='master';
  $('date').value=new Date().toISOString().slice(0,10);
  render();
};
document.addEventListener('keydown',e=>{
  if(e.key==='Enter' && ['search','date'].includes(document.activeElement?.id)) render();
});

function populateAfdFilter(){
  const sel=$('filterAfd');
  if(!sel)return;
  const current=sel.value;
  const afds=[...new Set(master.map(x=>(x.afd||'').trim()).filter(Boolean))].sort((a,b)=>a.localeCompare(b,'id'));
  sel.innerHTML='<option value="">Semua AFD</option>'+afds.map(a=>`<option value="${a.replace(/"/g,'&quot;')}">${a}</option>`).join('');
  if(afds.includes(current))sel.value=current;
}

window.renderFastDashboard=()=>{
  const d=$('date').value,mode=$('viewMode').value||'master',afd=$('filterAfd').value||'';
  let dateList=master.filter(x=>x.schedule===d);
  if(afd)dateList=dateList.filter(x=>(x.afd||'').trim()===afd);
  const masterFiltered=afd?master.filter(x=>(x.afd||'').trim()===afd):master;
  const targetList=mode==='date'?dateList:masterFiltered;
  const targetAtt=targetList.map(x=>attendance[x.nik+'_'+x.schedule]).filter(Boolean);
  const had=targetAtt.filter(x=>x.status==='HADIR / PROSES').length;
  const done=targetAtt.filter(x=>x.status==='MCU SELESAI').length;
  const abs=targetAtt.filter(x=>x.status==='TIDAK HADIR').length;
  const present=had+done,denom=targetList.length||0;
  $('kTotal').textContent=denom;
  $('kHad').textContent=had;
  $('kDone').textContent=done;
  $('kAbsent').textContent=abs;
  $('kProgress').textContent=(denom?Math.round(done/denom*100):0)+'%';
  document.querySelector('#kTotal').parentElement.querySelector('.l').textContent=mode==='master'?'Peserta master terfilter':'Peserta terjadwal';
  const attendancePct=denom?Math.round(present/denom*100):0;
  $('attendanceSummary').innerHTML=`<span class="sync">Kehadiran ${attendancePct}%</span><span class="status s1">Hadir/proses ${had}</span><span class="status s2">Selesai ${done}</span><span class="status s3">Tidak hadir ${abs}</span>`;
  $('operatorTitle').innerHTML=mode==='master'?'Master Peserta MCU — <span style="color:var(--green)">'+masterFiltered.length.toLocaleString('id-ID')+' peserta</span>':'Operator MCU — <span>'+$('dateLabel').textContent+'</span>';
  renderAfdMonitoring();
  renderHourly();
};

window.render=()=>{
  populateAfdFilter();
  const d=$('date').value,mode=$('viewMode').value||'master',afd=$('filterAfd').value||'';
  $('dateLabel').textContent=new Date(d+'T00:00:00').toLocaleDateString('id-ID',{day:'2-digit',month:'long',year:'numeric'});

  let dateList=master.filter(x=>x.schedule===d);
  if(afd)dateList=dateList.filter(x=>(x.afd||'').trim()===afd);

  const masterFiltered=afd?master.filter(x=>(x.afd||'').trim()===afd):master;
  const targetList=mode==='date'?dateList:masterFiltered;
  const targetAtt=targetList.map(x=>attendance[x.nik+'_'+x.schedule]).filter(Boolean);
  const had=targetAtt.filter(x=>x.status==='HADIR / PROSES').length;
  const done=targetAtt.filter(x=>x.status==='MCU SELESAI').length;
  const abs=targetAtt.filter(x=>x.status==='TIDAK HADIR').length;
  const present=had+done;
  const denom=targetList.length||0;

  $('kTotal').textContent=denom;
  $('kHad').textContent=had;
  $('kDone').textContent=done;
  $('kAbsent').textContent=abs;
  $('kProgress').textContent=(denom?Math.round(done/denom*100):0)+'%';
  document.querySelector('#kTotal').parentElement.querySelector('.l').textContent=mode==='master'?'Peserta master terfilter':'Peserta terjadwal';

  $('operatorTitle').innerHTML=mode==='master'
    ?'Master Peserta MCU — <span style="color:var(--green)">'+masterFiltered.length.toLocaleString('id-ID')+' peserta</span>'
    :'Operator MCU — <span>'+$('dateLabel').textContent+'</span>';

  const attendancePct=denom?Math.round(present/denom*100):0;
  $('attendanceSummary').innerHTML=
    `<span class="sync">Kehadiran ${attendancePct}%</span>
     <span class="status s1">Hadir/proses ${had}</span>
     <span class="status s2">Selesai ${done}</span>
     <span class="status s3">Tidak hadir ${abs}</span>`;

  renderTable();renderHistory();renderAfdMonitoring();renderHourly();
};

window.renderTable=()=>{
  const d=$('date').value,q=$('search').value.trim().toLowerCase(),f=$('filterStatus').value,mode=$('viewMode').value||'master',afd=$('filterAfd').value||'';
  let list=[...master];
  if(mode==='date') list=list.filter(x=>x.schedule===d);
  if(afd) list=list.filter(x=>(x.afd||'').trim()===afd);
  list=list.filter(x=>{
    const sd=mode==='date'?d:x.schedule;
    const s=attendance[x.nik+'_'+sd]?.status||'BELUM HADIR';
    return (!f||s===f) && (!q||[x.nik,x.name,x.afd,x.company,x.division,x.position,x.package,x.schedule].join(' ').toLowerCase().includes(q));
  });
  const limited=list.slice(0,500);
  $('rows').innerHTML=limited.map(x=>{
    const sd=x.schedule;
    const a=attendance[x.nik+'_'+sd]||{};
    const s=a.status||'BELUM HADIR';
    const cls=s==='MCU SELESAI'?'s2':s==='HADIR / PROSES'?'s1':s==='TIDAK HADIR'?'s3':'s0';
    const schedule=new Date(x.schedule+'T00:00:00').toLocaleDateString('id-ID',{day:'2-digit',month:'short',year:'numeric'});
    return `<tr>
      <td><b>${x.nik}</b></td>
      <td><b>${x.name}</b><div style="font-size:10px;color:var(--muted);margin-top:2px">${x.company||''} ${x.division?'• '+x.division:''} ${x.position?'• '+x.position:''}</div></td>
      <td>${x.afd}</td><td>${x.package||'-'}</td>
      <td><span class="status ${cls}">${s}</span></td>
      <td><small style="display:block;color:var(--muted);margin-bottom:4px">Jadwal: ${schedule}</small>
        <div class="actions">
          <button onclick="setStatus('${x.nik}','HADIR / PROSES','${sd}')">Hadir</button>
          <button class="done" onclick="setStatus('${x.nik}','MCU SELESAI','${sd}')">Selesai</button>
          <button onclick="setStatus('${x.nik}','TIDAK HADIR','${sd}')">Tidak Hadir</button>
          <button onclick="setStatus('${x.nik}','BELUM HADIR','${sd}')">Reset</button>
        </div>
      </td></tr>`;
  }).join('')||'<tr><td colspan="6" class="empty">Tidak ada peserta yang sesuai filter.</td></tr>';
};

window.renderHistory=()=>{
  const afd=$('filterAfd')?.value||'';
  const dates=[...new Set(master.map(x=>x.schedule).filter(Boolean))].sort();
  $('history').innerHTML=dates.map(d=>{
    let list=master.filter(x=>x.schedule===d);
    if(afd)list=list.filter(x=>(x.afd||'').trim()===afd);
    const done=list.filter(x=>attendance[x.nik+'_'+d]?.status==='MCU SELESAI').length;
    const had=list.filter(x=>attendance[x.nik+'_'+d]?.status==='HADIR / PROSES').length;
    const abs=list.filter(x=>attendance[x.nik+'_'+d]?.status==='TIDAK HADIR').length;
    const pct=list.length?Math.round(done/list.length*100):0;
    const selected=$('date').value===d&&$('viewMode').value==='date';
    return `<div class="day" style="${selected?'border:2px solid var(--green)':''}" onclick="document.getElementById('date').value='${d}';document.getElementById('viewMode').value='date';render()">
      <strong>${new Date(d+'T00:00:00').toLocaleDateString('id-ID',{day:'2-digit',month:'short',year:'numeric'})}</strong>
      <span>${done}/${list.length} selesai • ${had} proses • ${abs} tidak hadir • ${pct}%</span>
      <div class="bar"><i style="width:${pct}%"></i></div>
    </div>`;
  }).join('')||'<div class="empty">Belum ada jadwal MCU.</div>';
};


window.renderAfdMonitoring=()=>{
  const d=$('date').value, mode=$('viewMode').value||'master', afdFilter=$('filterAfd').value||'';
  let list=mode==='date' ? master.filter(x=>x.schedule===d) : [...master];
  if(afdFilter) list=list.filter(x=>(x.afd||'').trim()===afdFilter);
  const groups={};
  list.forEach(x=>{
    const a=(x.afd||'Tanpa AFD').trim()||'Tanpa AFD';
    if(!groups[a]) groups[a]=[];
    groups[a].push(x);
  });
  const rows=Object.entries(groups).sort((a,b)=>a[0].localeCompare(b[0],'id')).map(([a,arr])=>{
    const had=arr.filter(x=>{
      const sd=mode==='date'?d:x.schedule;
      return attendance[x.nik+'_'+sd]?.status==='HADIR / PROSES';
    }).length;
    const done=arr.filter(x=>{
      const sd=mode==='date'?d:x.schedule;
      return attendance[x.nik+'_'+sd]?.status==='MCU SELESAI';
    }).length;
    const abs=arr.filter(x=>{
      const sd=mode==='date'?d:x.schedule;
      return attendance[x.nik+'_'+sd]?.status==='TIDAK HADIR';
    }).length;
    const pct=arr.length?Math.round(done/arr.length*100):0;
    return `<tr>
      <td><b>${a}</b><div class="monitor-mini-bar"><i style="width:${pct}%"></i></div></td>
      <td>${arr.length}</td><td>${had}</td><td>${done}</td><td>${abs}</td><td><b>${pct}%</b></td>
    </tr>`;
  }).join('');
  $('afdMonitoring').innerHTML=rows
    ? `<div style="overflow:auto"><table class="monitor-table">
        <thead><tr><th>AFD</th><th>Total</th><th>Hadir</th><th>Selesai</th><th>TA</th><th>%</th></tr></thead>
        <tbody>${rows}</tbody>
      </table></div>`
    : '<div class="empty">Tidak ada peserta pada mode/filter ini.</div>';
};

window.renderHourly=()=>{
  const d=$('date').value, mode=$('viewMode').value||'master', afd=$('filterAfd').value||'';
  const arr=Array(24).fill(0);

  Object.values(attendance).forEach(x=>{
    if(x.status!=='MCU SELESAI'||!x.completedAt)return;

    // Mode tanggal = hanya transaksi pada tanggal MCU yang dipilih.
    // Mode master = seluruh transaksi yang tersimpan, karena operator sedang melihat seluruh master.
    if(mode==='date' && x.scheduledDate!==d)return;

    if(afd){
      const emp=master.find(m=>m.nik===x.nik);
      if(!emp || String(emp.afd||'').trim()!==afd)return;
    }

    const h=new Date(x.completedAt).getHours();
    if(Number.isFinite(h))arr[h]++;
  });

  let denominator;
  if(mode==='date'){
    denominator=master.filter(x=>x.schedule===d && (!afd || String(x.afd||'').trim()===afd)).length;
  }else{
    denominator=master.filter(x=>!afd || String(x.afd||'').trim()===afd).length;
  }

  const completed=arr.reduce((a,b)=>a+b,0);
  const pct=denominator?Math.round(completed/denominator*100):0;

  $('hourlyTop').innerHTML=
    `<div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:10px">
      <b>Kehadiran / penyelesaian per jam</b>
      <span class="sync">${pct}% selesai</span>
    </div>`+
    (arr.some(Boolean)
      ? arr.map((n,h)=>n?`<div style="display:flex;align-items:center;gap:8px;margin:6px 0">
          <b style="width:42px">${String(h).padStart(2,'0')}:00</b>
          <div class="bar" style="flex:1"><i style="width:${Math.round(n/Math.max(1,...arr)*100)}%"></i></div>
          <b>${n}</b>
        </div>`:'').join('')
      : `<div class="empty">${mode==='date'?'Belum ada transaksi MCU selesai pada tanggal ini.':'Belum ada transaksi MCU selesai tersimpan.'}</div>`);
};

window.importExcel=async ev=>{const file=ev.target.files[0];if(!file)return;const data=await file.arrayBuffer();const wb=XLSX.read(data,{type:'array',cellDates:true});const out=[];for(const sn of ['AMR','SIP']){const ws=wb.Sheets[sn];if(!ws)continue;const rows=XLSX.utils.sheet_to_json(ws,{defval:''});for(const r of rows){const nik=String(r['Emp No']??r['NIK']??r['Employee ID']??'').trim();const name=String(r['Name']??r['Nama']??'').trim();const conf=String(r['Konfirmasi data HRGA']??r['Konfirmasi']??'').trim().toUpperCase();if(!nik||!name||conf==='TIDAK')continue;let dt=r['Jadwal MCU']??r['Tanggal MCU']??'';if(dt instanceof Date)dt=dt.toISOString().slice(0,10);else if(dt){
  if(typeof dt==='number'){
    const epoch=new Date(Date.UTC(1899,11,30)+dt*86400000);
    dt=epoch.toISOString().slice(0,10);
  }else{
    const parsed=new Date(dt);
    if(!isNaN(parsed))dt=parsed.toISOString().slice(0,10);
  }
}out.push({nik,name,company:String(r['Company Id']??r['Company']??'').trim(),afd:String(r['AFD']??'').trim(),division:String(r['Org Name/Divisi']??r['Divisi']??'').trim(),position:String(r['Position Title']??r['Jabatan']??'').trim(),package:String(r['Paket MCU']??r['Paket']??'').trim(),schedule:dt,gender:String(r['Gender']??r['Jenis Kelamin']??'').trim(),age:String(r['Age']??r['Usia']??'').trim()})}}const map=new Map(out.map(x=>[x.nik,x]));master=[...map.values()];for(const x of master)await localPut('master',x);if(fs){const all=[...master];for(let i=0;i<all.length;i+=400){const b=writeBatch(fs);all.slice(i,i+400).forEach(x=>b.set(doc(fs,'employees',x.nik),x,{merge:true}));await b.commit()}}alert(`Master berhasil diimpor: ${master.length.toLocaleString('id-ID')} peserta.\n\nSekarang RANIA menampilkan seluruh master. Pilih Mode Data → MCU per Tanggal untuk operasional harian.`);if($('viewMode'))$('viewMode').value='master';if($('filterAfd'))$('filterAfd').value='';if($('filterStatus'))$('filterStatus').value='';render();ev.target.value=''};

window.exportHistory=()=>{const d=$('date').value;const rows=master.filter(x=>x.schedule===d).map(x=>{const a=attendance[x.nik+'_'+d]||{};return{Tanggal_MCU:d,NIK:x.nik,Nama:x.name,Perusahaan:x.company,AFD:x.afd,Divisi:x.division,Jabatan:x.position,Paket:x.package,Status:a.status||'BELUM HADIR',CheckIn:a.checkInAt||'',MCU_Selesai:a.completedAt||'',UpdatedAt:a.updatedAt||''}});const wb=XLSX.utils.book_new();XLSX.utils.book_append_sheet(wb,XLSX.utils.json_to_sheet(rows),'History MCU');XLSX.writeFile(wb,`RANIA_MCU_${d}.xlsx`)};

(async()=>{await localLoad();const cfg=localStorage.getItem('RANIA_FIREBASE_CONFIG');if(cfg){try{await connectFirebase(JSON.parse(cfg))}catch(e){console.warn(e)}}render()})();
</script>
</body></html>